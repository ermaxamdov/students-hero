# StudentHero - local ELMS worker configuration
#
# Copy this file to `.env.local` and fill in your real ELMS credentials.
# `.env.local` is gitignored and is read ONLY by the local Node worker.
#
# These names deliberately do NOT start with `VITE_`, which is what keeps them
# out of the browser bundle: Vite only exposes `VITE_*` variables to client
# code. Never rename these to VITE_ELMS_USERNAME / VITE_ELMS_PASSWORD.

ELMS_USERNAME=your.email@example.com
ELMS_PASSWORD=your-elms-password

# Daily sync time, local computer time, 24h HH:mm. Default 05:00.
ELMS_SYNC_TIME=05:00

# Port for the local worker's HTTP API that the frontend reads from.
ELMS_API_PORT=8787

# Optional: prefer the Windows-encrypted credential file (DPAPI) over the
# plaintext password above. Create it with:
#   npm run elms:save-credentials
# When the encrypted file exists it takes precedence and ELMS_PASSWORD can be
# removed from this file entirely.
